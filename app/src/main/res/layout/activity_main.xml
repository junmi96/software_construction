<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center" android:padding="32dp" android:background="#102538">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
 android:text="@string/game_title" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:layout_marginBottom="12dp" />
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
 android:text="@string/choose_difficulty" android:textColor="#C8DCEB" android:textSize="18sp" android:layout_marginBottom="24dp" />
 <Button android:id="@+id/easy_button" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/easy" />
 <Button android:id="@+id/normal_button" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/normal" android:layout_marginTop="12dp" />
 <Button android:id="@+id/hard_button" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/hard" android:layout_marginTop="12dp" />
 <androidx.appcompat.widget.SwitchCompat android:id="@+id/music_switch" android:layout_width="match_parent" android:layout_height="56dp"
 android:text="@string/music_enabled" android:textColor="#FFFFFF" android:layout_marginTop="24dp" />
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/game_hint"
 android:textColor="#C8DCEB" android:gravity="center" android:layout_marginTop="16dp" />
</LinearLayout>
