<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/game_bg" android:scaleType="centerCrop" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp" android:background="#E6071627">
        <TextView android:id="@+id/rank_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:padding="12dp" android:text="@string/app_name"
            android:textColor="@color/aw_white" android:textSize="22sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/rank_difficulties" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:background="@drawable/rank_row" android:padding="8dp">
            <RadioButton android:id="@+id/rank_easy" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/easy" android:buttonTint="?attr/colorPrimary" android:textColor="@color/aw_white" />
            <RadioButton android:id="@+id/rank_normal" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/normal" android:buttonTint="?attr/colorPrimary" android:textColor="@color/aw_white" />
            <RadioButton android:id="@+id/rank_hard" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/hard" android:buttonTint="?attr/colorPrimary" android:textColor="@color/aw_white" />
        </RadioGroup>
        <TextView android:id="@+id/rank_empty" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center" android:text="@string/rank_empty"
            android:textColor="@color/aw_muted" android:visibility="gone" />
        <ListView android:id="@+id/lv_rank" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" />
    </LinearLayout>
</FrameLayout>
