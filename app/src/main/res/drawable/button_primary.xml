<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#D3087EAA" />
            <stroke android:width="2dp" android:color="#FFBFEFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#D3102F59" android:endColor="#DB146589" />
            <stroke android:width="1.5dp" android:color="#FF19C9F3" />
        </shape>
    </item>
</selector>
